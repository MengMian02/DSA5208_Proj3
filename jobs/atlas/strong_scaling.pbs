#!/usr/bin/env bash
#PBS -N km-e2-strong
#PBS -q parallel
#PBS -j oe
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=96:mpiprocs=96:mem=64gb
#
# E2 MPI strong scaling, full Covertype, K=7, 30 fixed iterations, 3 repetitions.
# The parallel queue caps a job at 96 CPUs (resources_max.ncpus=96), so the
# sweep stops at 96 ranks instead of the 256 discussed for a multi-node run.
# One job runs the whole sweep so every point sees the same node and the same
# filesystem cache state.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/common.sh
preflight
build_cpu

OUT=$(job_results_path e2_strong)
echo "results=$OUT"
python3 scripts/run_mpi.py --experiment strong --ranks "${RANKS:-1,2,4,8,16,32,64,96}" \
  --repetitions "${REPS:-3}" --k 7 --max-iter 30 --nodes 1 --binding core --results "$OUT"
status=$?
if [ -f "$OUT" ]; then echo "runner_exit=$status rows=$(($(wc -l < "$OUT") - 1))"; else echo "runner_exit=$status rows=NO_CSV"; fi
exit $status
