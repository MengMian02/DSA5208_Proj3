#!/usr/bin/env bash
#PBS -N kmeans-weak
#PBS -j oe
#PBS -l walltime=01:30:00
#PBS -l select=1:ncpus=8:mpiprocs=8:ompthreads=1
#
# E3 weak scaling with deterministic local generation. Each rank builds its own
# 50000-observation block in memory from the preprocessed Covertype source.
# The source is cached once as a binary so 256 ranks read the shared file
# instead of receiving a 250 MB broadcast; drop SOURCE_BIN to measure the
# broadcast variant at small rank counts.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/common.sh
preflight
load_modules
build_if_needed

export OMP_NUM_THREADS=1
export MPI_LAUNCHER="$MPI_LAUNCHER"
export MPI_FLAGS=$(mpi_flags)

RANKS=$(printenv RANKS || echo "1,4,16,32,64,128,256")
REPS=$(printenv REPS || echo "$REPETITIONS")
PER_RANK=$(printenv PER_RANK || echo 50000)
SOURCE_BIN=$(printenv SOURCE_BIN || echo "$WORKDIR/cache/covtype_source.bin")
OUT="$RESULTS_DIR/e3_weak_$PBS_JOBID.csv"

mkdir -p "$(dirname "$SOURCE_BIN")"
echo "ranks=$RANKS per_rank=$PER_RANK source_bin=$SOURCE_BIN out=$OUT"
python3 scripts/run_mpi.py --experiment weak --ranks "$RANKS" --repetitions "$REPS" \
  --per-rank "$PER_RANK" --max-iter 30 --k 7 --source-bin "$SOURCE_BIN" --results "$OUT"
status=$?
echo "runner exit=$status"
exit $status
