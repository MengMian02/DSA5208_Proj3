#!/usr/bin/env bash
#PBS -N km-e1-serial
#PBS -q serial
#PBS -j oe
#PBS -l walltime=01:30:00
#PBS -l select=1:ncpus=1:mem=8gb
#
# E1 serial scaling on a compute node (never the login node). One core, so it
# goes to the serial queue, which is limited to ncpus=1 and mem<=15gb.
# Two grids at K=7/N=581012 and N/K sweeps, 30 fixed iterations, 3 repetitions.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/common.sh
preflight
build_cpu

OUT=$(job_results_path e1_serial)
echo "results=$OUT"
python3 scripts/run_e1.py --implementation serial --grid both \
  --repetitions "${REPS:-3}" --max-iter 30 --results "$OUT"
status=$?
if [ -f "$OUT" ]; then echo "runner_exit=$status rows=$(($(wc -l < "$OUT") - 1))"; else echo "runner_exit=$status rows=NO_CSV"; fi
exit $status
