# Atlas (PBS Pro) settings, filled from the probe on 2026-11-05.
# Everything here was observed on the cluster; nothing is assumed.

SCHEDULER=pbs
WORKDIR=/home/svu/e0550588/dsa5208
RESULTS_DIR=$WORKDIR/results
LOGS_DIR=$WORKDIR/logs

# Execution queues actually enabled and started at probe time:
#   parallel  resources_max.ncpus=96  resources_max.mem=540gb  walltime<=720h
#   serial    resources_max.ncpus=1   resources_max.mem=15gb
# normal/benchmark are disabled; vanda-style SLURM is not used here.
QUEUE=parallel
SERIAL_QUEUE=serial

# Parallel-queue compute nodes (cnode-33-43-*): 96 CPUs, 359 GB RAM each.
# The 96-CPU cap of the parallel queue is why E2/E3 stop at 96 ranks.
NODE_CORES=96

MPI_LAUNCHER=mpirun
REPETITIONS=3

# Toolchain is pinned in jobs/atlas/atlas_env.sh (GCC 7.3.0 + OpenMPI 4.1.1);
# environment modules are not used because the stock login environment breaks
# the link against OpenMPI.
