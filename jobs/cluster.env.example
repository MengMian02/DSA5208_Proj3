# Copy to jobs/cluster.env and fill in from an actual probe run.
#
#   qsub -I / salloc  ->  bash jobs/probe_cluster.sh
#
# Nothing in this file may be guessed. Every value below must come from the
# probe output or the cluster documentation; the job bodies refuse to run while
# a value still contains the string CHANGE_ME.

SCHEDULER=CHANGE_ME            # pbs (Atlas) or slurm (Vanda)
PROJECT_ACCOUNT=CHANGE_ME      # project / allocation code the scheduler bills
QUEUE=CHANGE_ME                # queue or partition from "qstat -Q" / "sinfo -s"
WORKDIR=CHANGE_ME              # absolute path of this repository on the cluster
RESULTS_DIR=$WORKDIR/results

# Module lines in the order the cluster documentation requires.
# Replace with the real module names printed by "module avail".
MODULE_MPI="CHANGE_ME"
MODULE_COMPILER="CHANGE_ME"
MODULE_PYTHON=""               # leave empty when the system python3 is enough

# MPI launcher: use whichever name the site documentation provides
# (mpirun, mpiexec, srun, ibrun).
MPI_LAUNCHER=CHANGE_ME

# Cores per node as reported by the probe (do not assume 64 or 128).
NODE_CORES=CHANGE_ME

# Build on the compute node when the cluster forbids compiling on login nodes.
BUILD_ON_COMPUTE_NODE=0

# Walltime per job and repetitions per configuration.
WALLTIME=CHANGE_ME
REPETITIONS=3
