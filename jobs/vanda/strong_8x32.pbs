#!/bin/bash
#PBS -N km-e2-s8x32
#PBS -P personal-e0550588
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:40:00
#PBS -l select=8:ncpus=32:mpiprocs=32:ompthreads=1:mem=100gb
#PBS -l place=scatter
#PBS -q auto
#
# E2 strong scaling, 256 ranks spread as 8 nodes x 32 cpus.
# Same core count and same total memory as the 4 x 64 variant, but each node
# only needs 32 free cores and ~222 GB (44% of RAM) instead of 64 cores and
# ~444 GB (89%), because PBS derives memory per chunk as ncpus x ~6.96 GB.
# Keeping both shapes queued is deliberate: whichever places first yields the
# 256-core point, and if both run they show the cost of crossing 8 nodes
# instead of 4 for the same work.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/vanda/common.sh
preflight
build_cpu

OUT=$(job_results_path e2_strong_8x32)
echo "results=$OUT"
python3 scripts/run_mpi.py --experiment strong \
  --ranks "${RANKS:-1,2,4,8,16,32,64,128,256}" \
  --repetitions "${REPS:-3}" --k 7 --max-iter 30 --nodes 8 --binding core --results "$OUT"
status=$?
if [ -f "$OUT" ]; then echo "runner_exit=$status rows=$(($(wc -l < "$OUT") - 1))"; else echo "runner_exit=$status rows=NO_CSV"; fi
exit $status
