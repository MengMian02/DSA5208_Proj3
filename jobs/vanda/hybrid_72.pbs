#!/bin/bash
#PBS -N km-e4-hyb72
#PBS -P personal-e0550588
#PBS -j oe
#PBS -k oed
#PBS -l walltime=01:30:00
#PBS -l select=1:ncpus=64:mpiprocs=16:ompthreads=4:mem=200gb
#PBS -q auto_free
#
# E4 hybrid layouts inside ONE node of the free pool, at ranks x threads = 64.
# cpu_parallel is bound to node pool cpu_free, which has 24 nodes: 20 with 64
# cores and only 3 with 72. A 72-core request therefore competes for 3 nodes
# and sat still with "Insufficient amount of resource: node_pool"; a 64-core
# request fits 20 of them. Nothing crosses a node boundary in any layout.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/vanda/common.sh
preflight
build_cpu

OUT=$(job_results_path e4_hybrid72)
LAYOUTS="64x1,32x2,16x4,8x8,4x16,2x32,1x64"
echo "results=$OUT layouts=${LAYOUTS:-$LAYOUTS}"
python3 scripts/run_mpi.py --experiment hybrid --layouts "${LAYOUTS:-$LAYOUTS}" \
  --repetitions "${REPS:-3}" --k 7 --max-iter 30 --nodes 1 --binding ppr --results "$OUT"
status=$?
if [ -f "$OUT" ]; then echo "runner_exit=$status rows=$(($(wc -l < "$OUT") - 1))"; else echo "runner_exit=$status rows=NO_CSV"; fi
exit $status
