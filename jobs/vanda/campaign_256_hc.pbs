#!/bin/bash
#PBS -N km-hc-256
#PBS -P personal-harry_chen
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:45:00
#PBS -l select=8:ncpus=32:mpiprocs=32:ompthreads=1:mem=64gb
#PBS -l place=scatter
#PBS -q auto
#
# 256-core campaign (8 nodes x 32 cores) on the ORIGINAL Covertype dataset (N=581012, K=7, D=54):
#   E2 MPI strong scaling      1..256 ranks
#   E3 MPI weak scaling        1..256 ranks, 50000 generated observations/rank
#   E4 Hybrid MPI+OpenMP       6 layouts at a fixed 256-core budget
# One job keeps the nodes, interconnect and filesystem cache state fixed across
# every point. Binaries are built by jobs/vanda/smoke_hc.pbs.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/vanda/common_harry.sh
preflight
require_binaries

echo "== allocation =="
sort "$PBS_NODEFILE" | uniq -c
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
echo "distinct_nodes=$NNODES"

echo "== rank placement =="
for n in 2 64 256; do
  echo "--- ranks=$n ---"
  mpirun -np "$n" $MPI_FLAGS hostname 2>/dev/null | sort | uniq -c
done

rc=0
OUT2=$(job_results_path e2_strong)
OUT3=$(job_results_path e3_weak)
OUT4=$(job_results_path e4_hybrid)
echo "results_e2=$OUT2"
echo "results_e3=$OUT3"
echo "results_e4=$OUT4"

echo "== E2 MPI strong scaling, original Covertype =="
python3 scripts/run_mpi.py --experiment strong \
  --ranks 1,2,4,8,16,32,64,128,256 \
  --repetitions 3 --k 7 --max-iter 30 --nodes "$NNODES" --binding core \
  --dataset-label covtype_original --results "$OUT2"
status=$?; echo "E2_exit=$status"; [ $status -eq 0 ] || rc=1

echo "== E3 MPI weak scaling, 50000 observations per rank =="
python3 scripts/run_mpi.py --experiment weak \
  --ranks 1,2,4,8,16,32,64,128,256 --per-rank 50000 \
  --repetitions 3 --k 7 --max-iter 30 --nodes "$NNODES" --binding core \
  --dataset-label covtype_weak_50k_per_rank --results "$OUT3"
status=$?; echo "E3_exit=$status"; [ $status -eq 0 ] || rc=1

echo "== E4 Hybrid MPI+OpenMP at 256 cores =="
python3 scripts/run_mpi.py --experiment hybrid \
  --layouts 256x1,128x2,64x4,32x8,16x16,8x32 \
  --repetitions 3 --k 7 --max-iter 30 --nodes "$NNODES" --binding ppr \
  --dataset-label covtype_original --results "$OUT4"
status=$?; echo "E4_exit=$status"; [ $status -eq 0 ] || rc=1

echo "== row counts =="
for f in "$OUT2" "$OUT3" "$OUT4"; do
  [ -f "$f" ] && echo "$(basename "$f") rows=$(($(wc -l < "$f") - 1))"
done
echo "CAMPAIGN_256_RC=$rc"
exit "$rc"
