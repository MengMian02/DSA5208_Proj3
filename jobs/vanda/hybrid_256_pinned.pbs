#!/bin/bash
#PBS -N km-e4-pinned
#PBS -P personal-e0550588
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:40:00
#PBS -l select=4:ncpus=64:mpiprocs=64:ompthreads=1:mem=100gb
#PBS -l place=scatter
#PBS -q auto
#
# E4 at 256 cores, PINNED with --map-by core --bind-to core.
#
# Why only the 256x1 layout: "--bind-to core" pins each process to one core, so
# a layout with T>1 threads would put an entire OpenMP team on a single core.
# Per-rank core reservation (ppr/slot/node :pe=T) hangs on this cluster, so a
# multi-thread layout cannot be pinned at all. 256x1 is therefore the one hybrid
# configuration that can be measured with real binding - and it is also the
# layout that showed 138% run-to-run spread when it was unpinned (0.027 / 0.769 /
# 1.088 s), so this is the direct test of whether binding is the cause.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/vanda/common.sh
preflight
build_cpu

OUT=$(job_results_path e4_pinned_4x64)
echo "results=$OUT"
python3 scripts/run_mpi.py --experiment hybrid --layouts "${LAYOUTS:-256x1}" \
  --repetitions "${REPS:-5}" --k 7 --max-iter 30 --nodes 4 --binding core --results "$OUT"
status=$?
if [ -f "$OUT" ]; then echo "runner_exit=$status rows=$(($(wc -l < "$OUT") - 1))"; else echo "runner_exit=$status rows=NO_CSV"; fi
exit $status
