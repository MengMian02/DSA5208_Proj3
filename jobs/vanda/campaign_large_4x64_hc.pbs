#!/bin/bash
#PBS -N km-hc-10m
#PBS -P personal-harry_chen
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:30:00
#PBS -l select=4:ncpus=64:mpiprocs=64:ompthreads=1
#PBS -l place=scatter
#PBS -q auto
#
# E2-large + E4-large (4 nodes x 64 cores): MPI strong scaling and Hybrid MPI+OpenMP
# on a FIXED 10,000,000-observation logical
# workload generated deterministically from the preprocessed Covertype source.
# --resampled-total makes N independent of the rank count, so 1 and 256 ranks
# process exactly the same rows in the same order with the same initial
# centroids. This is benchmark data, not 10M independent forest observations.
cd "$PBS_O_WORKDIR" || exit 1
. jobs/vanda/common_harry.sh
preflight
require_binaries

echo "== allocation =="
sort "$PBS_NODEFILE" | uniq -c
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)

rc=0
OUT=$(job_results_path e2_large)
OUT4=$(job_results_path e4_hybrid_10m)
echo "results_e2_large=$OUT"
python3 scripts/run_mpi.py --experiment strong \
  --ranks 1,2,4,8,16,32,64,128,256 \
  --resampled-total 10000000 \
  --repetitions 3 --k 7 --max-iter 30 --nodes "$NNODES" --binding core \
  --dataset-label covtype_resampled_10M --results "$OUT"
status=$?; echo "E2_large_exit=$status"; [ $status -eq 0 ] || rc=1

echo "results_e4_10m=$OUT4"
echo "== E4 Hybrid MPI+OpenMP on the 10M resampled workload, 256 cores =="
python3 scripts/run_mpi.py --experiment hybrid \
  --layouts 256x1,128x2,64x4,32x8,16x16,8x32 \
  --resampled-total 10000000 \
  --repetitions 3 --k 7 --max-iter 30 --nodes "$NNODES" --binding ppr \
  --dataset-label covtype_resampled_10M --results "$OUT4"
status=$?; echo "E4_10m_exit=$status"; [ $status -eq 0 ] || rc=1

echo "== row counts =="
for f in "$OUT" "$OUT4"; do
  [ -f "$f" ] && echo "$(basename "$f") rows=$(($(wc -l < "$f") - 1))"
done
echo "CAMPAIGN_LARGE_RC=$rc"
exit "$rc"
